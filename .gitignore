# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
# 打包产物 / 体积测量用的临时导出目录（expo export --output-dir .tmp-xxx）
# 用通配而不是逐个写：之前 .tmp-bundle 就是这么被 git add -A 带进仓库的（4MB 的 hbc + 资源）
.tmp*/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# 本地构建产物（apk / aab），不要提交到仓库
build/

# 本地扫码页（Expo 连接二维码，随 IP 变化重生成）
.qr*
