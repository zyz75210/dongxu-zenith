{
  "expo": {
    "name": "跳程 Zenith",
    "slug": "CalendarApp",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "buildNumber": "6",
      "bundleIdentifier": "com.zenith.dongxu"
    },
    "android": {
      "package": "com.zenith.dongxu",
      "versionCode": 6,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-notifications",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "跳程需要相机权限，用来识别你的跳绳动作并录制训练视频",
          "enableMicrophonePermission": true,
          "microphonePermissionText": "跳程需要麦克风权限，用来给训练视频录音"
        }
      ],
      [
        "react-native-mediapipe-posedetection",
        {
          "assetsPaths": [
            "./assets/models/"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "跳程需要麦克风权限，用来给训练录音",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "adc38a70-7cf5-4da9-b20a-5b981acf30c2"
      }
    },
    "owner": "zyzok"
  }
}
